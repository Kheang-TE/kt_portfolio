{
    "name": "kheang/kt-portfolio",
    "description": "Portfolio plugin for WordPress with CPT, Gutenberg blocks, REST API and shortcodes",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.11",
        "szepeviktor/phpstan-wordpress": "^1.0",
        "squizlabs/php_codesniffer": "^3.8",
        "wp-coding-standards/wpcs": "^3.0",
        "phpunit/phpunit": "^9.6",
        "10up/wp_mock": "^0.5"
    },
    "autoload": {
        "psr-4": {
            "KT_Portfolio\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KT_Portfolio\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "phpcs --standard=WordPress .",
        "lint:fix": "phpcbf --standard=WordPress .",
        "analyse": "phpstan analyse --memory-limit=256M",
        "test": "phpunit --bootstrap tests/bootstrap.php tests/",
        "ci": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}