includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 5
    paths:
        - includes
        - kt_portfolio.php
    excludePaths:
        - tests
        - vendor
        - languages
    checkMissingIterableValueType: false
    treatPhpDocTypesAsCertain: true
    bootstrapFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
        - vendor/autoload.php
        - kt_portfolio.php
        - includes/Admin/Metaboxes/Metabox_Interface.php